--[[
	Chaos Engine Runtime :: EventManager

	Game-agnostic event execution layer. It knows nothing about STALKER, about
	Discord, or about the transport. Game adapters register event definitions
	into it; the IPC layer asks it to run them by id.

	An event definition is a table:

		{
			id       = "spawn_bloodsucker",   -- unique, [a-z0-9_]
			name     = "Bloodsucker Hunt",    -- display name
			category = "mutants",
			duration = 0,                     -- seconds the event stays "active"
			                                  --   0 = instant (fire and forget)
			cooldown = 120,                   -- seconds before it may run again
			weight   = 1.0,                   -- rarity hint for the picker
			params   = {                      -- optional parameter schema
				count = { type = "number", min = 1, max = 10, default = 5 },
			},
			available = function(ctx) ... end,           -- optional gate
			execute   = function(ctx, params) ... end,   -- required
			cleanup   = function(ctx, state) ... end,    -- optional, for duration > 0
		}

	execute() must return one of:
		true                      -- success
		true, state               -- success, state passed back to cleanup()
		false, "reason"           -- failure
--]]

local registry   = {}   -- id -> definition
local order      = {}   -- insertion order of ids
local cooldowns  = {}   -- id -> game time (ms) when the event becomes available
local active     = {}   -- instance_id -> { def, state, expires_at }
local next_inst  = 1

-- Minimum gap between any two events, regardless of per-event cooldown.
global_cooldown = 0
local global_ready_at = 0

--------------------------------------------------------------------------------
-- helpers
--------------------------------------------------------------------------------

local function now()
	return time_global()
end

local function log()
	return chaos_rt_log
end

--------------------------------------------------------------------------------
-- registration
--------------------------------------------------------------------------------

function register(def)
	if type(def) ~= "table" then
		log().error("register: definition is not a table")
		return false
	end
	if type(def.id) ~= "string" or not def.id:match("^[a-z0-9_]+$") then
		log().error("register: invalid id %s", tostring(def.id))
		return false
	end
	if type(def.execute) ~= "function" then
		log().error("register: event %s has no execute()", def.id)
		return false
	end
	if registry[def.id] then
		log().warn("register: event %s registered twice, overwriting", def.id)
	else
		order[#order + 1] = def.id
	end

	def.name     = def.name or def.id
	def.category = def.category or "misc"
	def.duration = tonumber(def.duration) or 0
	def.cooldown = tonumber(def.cooldown) or 0
	def.weight   = tonumber(def.weight) or 1.0
	def.params   = def.params or {}

	registry[def.id] = def
	log().debug("registered event %s (%s)", def.id, def.category)
	return true
end

function get(id)
	return registry[id]
end

function count()
	return #order
end

-- Returns an array of plain description tables, safe to hand to the transport.
function describe()
	local out = {}
	for i = 1, #order do
		local def = registry[order[i]]
		if def then
			local params = {}
			local has_params = false
			for k, spec in pairs(def.params) do
				has_params = true
				params[k] = {
					type    = spec.type or "number",
					min     = spec.min,
					max     = spec.max,
					default = spec.default,
				}
			end
			out[#out + 1] = {
				id        = def.id,
				name      = def.name,
				category  = def.category,
				duration  = def.duration,
				cooldown  = def.cooldown,
				weight    = def.weight,
				params    = has_params and params or chaos_rt_json.EMPTY_OBJECT,
				available = is_available(def.id),
			}
		end
	end
	return out
end

--------------------------------------------------------------------------------
-- cooldowns / availability
--------------------------------------------------------------------------------

function cooldown_remaining(id)
	local until_ms = cooldowns[id]
	if not until_ms then return 0 end
	local left = until_ms - now()
	if left <= 0 then
		cooldowns[id] = nil
		return 0
	end
	return math.ceil(left / 1000)
end

function is_available(id)
	local def = registry[id]
	if not def then return false end
	if cooldown_remaining(id) > 0 then return false end
	if global_ready_at > now() then return false end
	if def.available then
		local ok, res = pcall(def.available, context())
		if not ok then
			log().error("available() for %s raised: %s", id, tostring(res))
			return false
		end
		if not res then return false end
	end
	return true
end

function clear_cooldowns()
	cooldowns = {}
	global_ready_at = 0
end

--------------------------------------------------------------------------------
-- parameter validation
--------------------------------------------------------------------------------

local function validate_params(def, params)
	local clean = {}
	params = params or {}
	for key, spec in pairs(def.params) do
		local v = params[key]
		local want = spec.type or "number"
		if v == nil then
			v = spec.default
		elseif want == "number" then
			v = tonumber(v)
			if v == nil then
				return nil, string.format("parameter '%s' must be a number", key)
			end
		elseif want == "boolean" then
			if type(v) ~= "boolean" then
				return nil, string.format("parameter '%s' must be a boolean", key)
			end
		elseif want == "string" then
			if type(v) ~= "string" then
				return nil, string.format("parameter '%s' must be a string", key)
			end
		end
		if want == "number" and type(v) == "number" then
			if spec.min and v < spec.min then v = spec.min end
			if spec.max and v > spec.max then v = spec.max end
		end
		clean[key] = v
	end
	return clean, nil
end

--------------------------------------------------------------------------------
-- execution context
--------------------------------------------------------------------------------

-- The context is the only thing event implementations are given. Keeping it
-- explicit means the engine could be pointed at a different game by swapping
-- the adapter that fills it in.
function context()
	return {
		actor = db and db.actor or nil,
		now   = now(),
		log   = chaos_rt_log,
		ui    = chaos_rt_ui,
	}
end

--------------------------------------------------------------------------------
-- execution
--------------------------------------------------------------------------------

--- Run an event by id.
-- @param id      string
-- @param params  table|nil
-- @param opts    table|nil  { ignore_cooldown = bool, source = string }
-- @return table  { success = bool, error = string|nil, instance_id = number|nil }
function execute(id, params, opts)
	opts = opts or {}
	local def = registry[id]
	if not def then
		log().warn("execute: unknown event id '%s'", tostring(id))
		return { success = false, error = "unknown_event" }
	end

	if not opts.ignore_cooldown then
		local left = cooldown_remaining(id)
		if left > 0 then
			return { success = false, error = "on_cooldown", cooldown_remaining = left }
		end
		if global_ready_at > now() then
			return { success = false, error = "global_cooldown" }
		end
		if def.available then
			local ok, res = pcall(def.available, context())
			if not ok or not res then
				return { success = false, error = "unavailable" }
			end
		end
	end

	local clean, perr = validate_params(def, params)
	if perr then
		log().warn("execute: %s rejected: %s", id, perr)
		return { success = false, error = "bad_parameters", message = perr }
	end

	local ctx = context()
	local ok, res, state = pcall(def.execute, ctx, clean)
	if not ok then
		log().error("execute: %s raised: %s", id, tostring(res))
		return { success = false, error = "exception", message = tostring(res) }
	end
	if res == false then
		local reason = tostring(state or "failed")
		log().warn("execute: %s refused: %s", id, reason)
		return { success = false, error = "refused", message = reason }
	end

	-- Success. Arm cooldowns.
	if def.cooldown > 0 then
		cooldowns[id] = now() + def.cooldown * 1000
	end
	if global_cooldown > 0 then
		global_ready_at = now() + global_cooldown * 1000
	end

	local instance_id = nil
	if def.duration > 0 then
		instance_id = next_inst
		next_inst = next_inst + 1
		active[instance_id] = {
			def        = def,
			state      = state,
			expires_at = now() + def.duration * 1000,
		}
	end

	log().info("executed '%s' (%s) source=%s", def.name, id, tostring(opts.source or "local"))
	return { success = true, instance_id = instance_id, name = def.name, duration = def.duration }
end

--- Pick a random event honouring weight and availability. Used by "random_event"
--- style events and by offline testing; the bot does its own picking.
function pick_random(filter)
	local pool, total = {}, 0
	for i = 1, #order do
		local def = registry[order[i]]
		if def and is_available(def.id) and (not filter or filter(def)) then
			total = total + def.weight
			pool[#pool + 1] = { def = def, acc = total }
		end
	end
	if total <= 0 then return nil end
	local roll = math.random() * total
	for i = 1, #pool do
		if roll <= pool[i].acc then return pool[i].def.id end
	end
	return pool[#pool].def.id
end

--------------------------------------------------------------------------------
-- lifecycle
--------------------------------------------------------------------------------

function active_events()
	local out = {}
	for instance_id, entry in pairs(active) do
		out[#out + 1] = {
			instance_id = instance_id,
			id          = entry.def.id,
			name        = entry.def.name,
			remaining   = math.max(0, math.ceil((entry.expires_at - now()) / 1000)),
		}
	end
	return out
end

local function finish(instance_id, entry)
	active[instance_id] = nil
	if entry.def.cleanup then
		local ok, err = pcall(entry.def.cleanup, context(), entry.state)
		if not ok then
			log().error("cleanup: %s raised: %s", entry.def.id, tostring(err))
		end
	end
	log().debug("event '%s' finished", entry.def.id)
end

--- Called every tick by the boot script.
function update()
	local t = now()
	for instance_id, entry in pairs(active) do
		if t >= entry.expires_at then
			finish(instance_id, entry)
		end
	end
end

--- Drop everything, e.g. on level change or new game.
function reset()
	for instance_id, entry in pairs(active) do
		finish(instance_id, entry)
	end
	active = {}
	clear_cooldowns()
	log().info("event manager reset")
end
