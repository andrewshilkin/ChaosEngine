--[[
	Chaos Engine :: STALKER Anomaly adapter -- event definitions

	This is the only file in the mod that contains game knowledge. Everything
	else (chaos_rt_*) is reusable runtime. To support a different game, write a
	new file like this one and leave the runtime alone.

	Events are grouped by category. The host builds each ballot from *different*
	categories, so a vote offers a monster, some loot, a world change and a
	player effect rather than four spawns in a row.

	    mutants    things that want to eat you
	    factions   things that want to shoot you
	    player     something happens to the player directly
	    loot       something appears that is worth picking up
	    world      the Zone itself changes
--]]

local INVALID_VERTEX = 4294967295

--------------------------------------------------------------------------------
-- placement
--------------------------------------------------------------------------------

local function actor_online()
	return db and db.actor and db.actor:alive() and true or false
end

--[[
	Finding somewhere to put a spawn.

	level.vertex_in_direction() walks the AI grid, and when the walk is blocked
	-- indoors, against a cliff, in a corridor -- it returns the last vertex it
	could reach, which can be right on top of the player. The first version
	trusted the result and that is exactly how bloodsuckers ended up in the
	player's face.

	So: try several directions, measure the distance actually achieved, and only
	accept a candidate that really is far enough away. If none of the attempts
	work, the event refuses. Nothing appearing at all is a better outcome than a
	bloodsucker spawning inside the player.
--]]
local SPAWN_ATTEMPTS = 12

local function find_spawn_point(min_d, max_d)
	local actor = db.actor
	local base_vid = actor:level_vertex_id()
	local apos = actor:position()
	local best_dist = 0

	for _ = 1, SPAWN_ATTEMPTS do
		local angle = math.random() * math.pi * 2
		local want = min_d + math.random() * (max_d - min_d)
		local dir = vector():set(math.cos(angle), 0, math.sin(angle))

		local vid = level.vertex_in_direction(base_vid, dir, want)
		if vid and vid < INVALID_VERTEX then
			local pos = level.vertex_position(vid)
			local got = apos:distance_to(pos)
			if got >= min_d then
				return pos, vid, actor:game_vertex_id()
			end
			if got > best_dist then best_dist = got end
		end
	end

	chaos_rt_log.warn("spawn: no point at least %.0fm away after %d tries (best %.1fm)",
		min_d, SPAWN_ATTEMPTS, best_dist)
	return nil
end

--- Spawn `count` of a random pick from `sections`, each at its own point so a
--- group arrives spread out rather than stacked.
local function spawn_around(sections, count, min_d, max_d)
	local spawned = 0
	for _ = 1, count do
		local pos, lvid, gvid = find_spawn_point(min_d, max_d)
		if pos then
			local section = sections[math.random(#sections)]
			local se_obj = alife_create(section, pos, lvid, gvid)
			if se_obj then
				spawned = spawned + 1
			else
				chaos_rt_log.warn("spawn: alife_create('%s') returned nil", section)
			end
		end
	end
	return spawned
end

local function announce(name, n)
	if n > 1 then
		chaos_rt_ui.notify(string.format("%s x %d", name, n), 5)
	else
		chaos_rt_ui.notify(name, 5)
	end
end

--------------------------------------------------------------------------------
-- spawn tiers
--------------------------------------------------------------------------------

--[[
	Danger tier decides how many appear and how far away, so the numbers come
	from one place instead of per-event guesswork. The count cap is declared on
	the event's parameter, which means the *game* enforces it: the validator
	clamps whatever the host asks for.

	Distances are deliberately generous. Something that spawns 30 m away and
	comes looking for you is a fight; something that spawns 8 m away is an
	ambush you never had a chance to react to.
--]]
local TIERS = {
	-- One of these is already a fight worth losing.
	apex  = { min = 1, max = 1, default = 1, near = 30, far = 50 },
	-- Individually weak, dangerous in numbers.
	pack  = { min = 1, max = 6, default = 4, near = 22, far = 38 },
	-- Armed humans. They shoot from range, so they start further out.
	squad = { min = 1, max = 4, default = 3, near = 35, far = 60 },
	-- Harmless scenery: corpses, crates.
	prop  = { min = 1, max = 3, default = 1, near = 12, far = 25 },
}

