--[[
	An ally who tags along.

	Recruiting is a two-step job. alife_create() makes a *server* object, but
	axr_companions.add_to_actor_squad() needs the online game object, which does
	not exist until the engine switches the NPC in -- a second or two later, and
	sometimes not at all if the spawn point was out of range.

	So: spawn, then poll with CreateTimeEvent until the object shows up, and
	give up quietly after a few seconds rather than retrying forever.
--]]
local ALLY_SECTIONS = {
	"sim_default_stalker_1", "sim_default_stalker_2", "sim_default_stalker_3",
	"sim_default_csky_1", "sim_default_csky_2",
	"sim_default_duty_2", "sim_default_freedom_2",
}

local ALLY_RECRUIT_TRIES = 12

local function recruit_when_online(id, tries)
	local obj = level.object_by_id(id)
	if obj then
		local ok, err = pcall(function()
			axr_companions.add_to_actor_squad(obj)
		end)
		if ok then
			chaos_rt_ui.notify(obj:character_name() .. " is with you", 6)
			chaos_rt_log.info("ally %s (%s) joined the squad", obj:name(), id)
		else
			chaos_rt_log.warn("ally %s could not be recruited: %s", tostring(id), tostring(err))
		end
		return true
	end

	if tries <= 0 then
		chaos_rt_log.warn("ally %s never came online, giving up", tostring(id))
		return true
	end
	CreateTimeEvent("chaos_ally_" .. id, "recruit", 1, recruit_when_online, id, tries - 1)
	return true
end

local function def_spawn_ally()
	return {
		id = "spawn_ally", name = "A Friend", category = "factions",
		duration = 0, cooldown = 420, weight = 0.5,
		available = function()
			if not actor_online() then return false end
			-- Without the companion framework this would spawn a stranger who
			-- wanders off, which is not the event anyone voted for.
			return axr_companions ~= nil
		end,
		execute = function(ctx, params)
			local section = ALLY_SECTIONS[math.random(#ALLY_SECTIONS)]
			-- Close enough to walk over, far enough not to appear on top of you.
			local pos, lvid, gvid = find_spawn_point(12, 20)
			if not pos then return false, "nowhere to put them" end

			local se_obj = alife_create(section, pos, lvid, gvid)
			if not se_obj then return false, "could not create " .. section end

			CreateTimeEvent("chaos_ally_" .. se_obj.id, "recruit", 1,
				recruit_when_online, se_obj.id, ALLY_RECRUIT_TRIES)
			chaos_rt_ui.notify("Someone is coming to help", 5)
			return true
		end,
	}
end

--- Shared factory for anything that spawns a group of creatures.
local function def_spawn(spec, category)
	local tier = TIERS[spec.tier]
	return {
		id       = spec.id,
		name     = spec.name,
		category = category,
		duration = 0,
		cooldown = spec.cooldown,
		weight   = spec.weight,
		params   = {
			count = {
				type    = "number",
				min     = tier.min,
				max     = tier.max,
				default = spec.count or tier.default,
			},
		},
		available = actor_online,
		execute = function(ctx, params)
			local n = spawn_around(spec.sections, params.count, tier.near, tier.far)
			if n == 0 then return false, "nowhere to put it" end
			announce(spec.name, n)
			return true
		end,
	}
end

