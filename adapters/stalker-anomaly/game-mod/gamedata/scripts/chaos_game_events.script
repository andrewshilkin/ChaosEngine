local WEAPONS = {
	"wpn_ak74", "wpn_abakan", "wpn_mp5", "wpn_pm", "wpn_toz34",
	"wpn_svd", "wpn_spas12", "wpn_groza", "wpn_vintorez", "wpn_fn2000",
	"wpn_sig550", "wpn_val", "wpn_desert_eagle", "wpn_protecta",
}

local SUPPLIES = {
	"medkit", "medkit_army", "medkit_scientic", "bandage", "antirad",
	"energy_drink", "conserva", "bread", "vodka",
	"ammo_5.45x39_fmj", "ammo_9x18_fmj", "ammo_12x70_buck",
	"grenade_f1", "grenade_rgd5",
}

local ARTEFACTS = {
	"af_medusa", "af_night_star", "af_cristall", "af_fireball", "af_gravi",
}

local CORPSES = {
	"sim_default_stalker_dead", "sim_default_bandit_dead",
	"sim_default_military_dead", "sim_default_csky_dead",
	"sim_default_duty_dead", "sim_default_freedom_dead",
	"sim_default_killer_dead", "sim_default_renegade_dead",
}

local function def_give_random_weapon()
	return {
		id = "give_random_weapon", name = "Random Weapon", category = "loot",
		duration = 0, cooldown = 90, weight = 1.0,
		available = actor_online,
		execute = function(ctx, params)
			local section = WEAPONS[math.random(#WEAPONS)]
			local obj = alife_create_item(section, db.actor, { cond_r = { 0.6, 1.0 } })
			if not obj then return false, "could not create " .. section end
			chaos_rt_ui.notify("Supply drop: " .. section, 5)
			return true
		end,
	}
end

--[[
	Named starter weapons.

	"Random Weapon" can hand a fresh character an SVD or nothing they can feed,
	so these are the specific, predictable options: a gun plus ammo for it, so
	the thing that arrives is immediately usable.
--]]
local STARTER_KITS = {
	{
		id = "give_pistol", name = "Pistol", weight = 1.0, cooldown = 120,
		weapon = "wpn_pm", ammo = "ammo_9x18_fmj", ammo_count = 3,
	},
	{
		id = "give_shotgun", name = "Shotgun", weight = 1.0, cooldown = 120,
		weapon = "wpn_toz34", ammo = "ammo_12x70_buck", ammo_count = 3,
	},
	{
		id = "give_smg", name = "SMG", weight = 1.0, cooldown = 120,
		weapon = "wpn_mp5", ammo = "ammo_9x19_fmj", ammo_count = 3,
	},
}

local function def_starter_kit(spec)
	return {
		id = spec.id, name = spec.name, category = "loot",
		duration = 0, cooldown = spec.cooldown, weight = spec.weight,
		available = actor_online,
		execute = function(ctx, params)
			if not alife_create_item(spec.weapon, db.actor, { cond_r = { 0.7, 1.0 } }) then
				return false, "could not create " .. spec.weapon
			end
			for _ = 1, spec.ammo_count do
				alife_create_item(spec.ammo, db.actor)
			end
			chaos_rt_ui.notify(spec.name .. " and ammo", 5)
			return true
		end,
	}
end

--[[
	Simple "here is a pile of things" handouts.

	One row per event. `items` is a list of sections picked from at random,
	`count` how many to hand over. Everything specific enough to be worth voting
	for on its own belongs here rather than inside the Random Weapon lottery.
--]]
local HANDOUTS = {
	{
		id = "give_ammo", name = "Ammo Crate", cooldown = 100, weight = 1.0,
		-- Boxes, not rounds: a box is 30ish, so two is a decent resupply.
		count = 2, max = 6,
		items = {
			"ammo_5.45x39_fmj", "ammo_5.45x39_ap", "ammo_5.56x45_ss190",
			"ammo_9x18_fmj", "ammo_9x19_fmj", "ammo_11.43x23_fmj",
			"ammo_12x70_buck", "ammo_7.62x54_7h1",
		},
	},
	{
		id = "give_medkits", name = "First Aid", cooldown = 120, weight = 1.0,
		count = 4, max = 8,
		items = { "medkit", "medkit_army", "medkit_scientic", "bandage", "antirad" },
	},
	{
		id = "give_food", name = "Rations", cooldown = 100, weight = 0.9,
		count = 4, max = 8,
		items = { "conserva", "bread", "energy_drink" },
	},
	{
		id = "give_vodka", name = "Vodka", cooldown = 150, weight = 0.8,
		count = 3, max = 6,
		items = { "vodka" },
	},
	{
		id = "give_tools", name = "Kit Bag", cooldown = 240, weight = 0.6,
		count = 1, max = 3,
		items = { "device_torch", "wpn_binoc", "detector_simple", "helm_respirator", "helm_hardhat" },
	},
	{
		id = "give_armour", name = "Armour", cooldown = 300, weight = 0.4,
		count = 1, max = 1,
		items = { "novice_outfit", "stalker_outfit", "svoboda_light_outfit" },
	},
}

local function def_handout(spec)
	return {
		id = spec.id, name = spec.name, category = "loot",
		duration = 0, cooldown = spec.cooldown, weight = spec.weight,
		params = {
			count = { type = "number", min = 1, max = spec.max, default = spec.count },
		},
		available = actor_online,
		execute = function(ctx, params)
			local given = 0
			for _ = 1, params.count do
				local section = spec.items[math.random(#spec.items)]
				if alife_create_item(section, db.actor) then given = given + 1 end
			end
			if given == 0 then return false, "could not create anything" end
			announce(spec.name, given)
			return true
		end,
	}
end

local function def_give_grenades()
	return {
