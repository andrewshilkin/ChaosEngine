--------------------------------------------------------------------------------
-- player
--------------------------------------------------------------------------------

local function def_heal_player()
	return {
		id = "heal_player", name = "Full Heal", category = "player",
		duration = 0, cooldown = 120, weight = 1.0,
		available = actor_online,
		execute = function(ctx, params)
			local actor = db.actor
			-- Same idiom Anomaly itself uses for a full heal (bind_stalker_ext).
			actor.health = 1
			actor.bleeding = 1
			actor.psy_health = 1
			actor.radiation = 0
			chaos_rt_ui.notify("Patched up", 5)
			return true
		end,
	}
end

local function def_damage_player()
	return {
		id = "damage_player", name = "Pain", category = "player",
		duration = 0, cooldown = 90, weight = 1.0,
		params = { power = { type = "number", min = 0.05, max = 0.6, default = 0.25 } },
		available = actor_online,
		execute = function(ctx, params)
			local actor = db.actor
			-- Refuse to kill outright; chaos should hurt, not end the run.
			if actor.health <= params.power + 0.05 then
				return false, "would be lethal"
			end
			local h = hit()
			h.draftsman = actor
			h.type = hit.wound
			h.power = params.power
			h.impulse = 0
			h.direction = vector():set(0, 0, 1)
			h:bone("bip01_spine")
			actor:hit(h)
			chaos_rt_ui.notify("That hurt.", 4)
			return true
		end,
	}
end

local function def_irradiate()
	return {
		id = "irradiate_player", name = "Hot Dose", category = "player",
		duration = 0, cooldown = 150, weight = 0.8,
		params = { amount = { type = "number", min = 0.05, max = 0.5, default = 0.2 } },
		available = actor_online,
		execute = function(ctx, params)
			db.actor.radiation = params.amount
			chaos_rt_ui.notify("Your detector is screaming", 5)
			return true
		end,
	}
end

--- A post-process effector id of our own, kept well clear of the 2012-2020
--- range Anomaly's own actor_effects uses.
local PPE_ALCOHOL = 7331

local function def_drunk()
	return {
		id = "drunk", name = "Drunk", category = "player",
		-- The first event with a real duration: the effector runs until cleanup
		-- takes it away again. See chaos_rt_manager for the lifecycle.
		duration = 60, cooldown = 300, weight = 0.8,
		params = { seconds = { type = "number", min = 10, max = 180, default = 60 } },
		available = actor_online,
		execute = function(ctx, params)
			-- true = cyclic, so it keeps going until removed.
			level.add_pp_effector("alcohol.ppe", PPE_ALCOHOL, true)
			chaos_rt_ui.notify("You feel unsteady", 5)
			return true, { effector = PPE_ALCOHOL }
		end,
		cleanup = function(ctx, state)
			level.remove_pp_effector(state and state.effector or PPE_ALCOHOL)
			chaos_rt_ui.notify("Your head clears", 4)
		end,
	}
end

local function def_save_game()
	return {
		id = "save_game", name = "Checkpoint", category = "player",
		duration = 0, cooldown = 300, weight = 0.6,
		available = actor_online,
		execute = function(ctx, params)
			-- Same idiom Anomaly uses for its own autosaves (itms_manager).
			exec_console_cmd("save " .. user_name() .. " - chaos")
			chaos_rt_ui.notify("Checkpoint saved", 5)
			return true
		end,
	}
end

--------------------------------------------------------------------------------
-- sound
--------------------------------------------------------------------------------

-- Only paths Anomaly's own scripts already reference, so they are known to ship.
local SOUNDS = {
	{ name = "Siren",     path = "ambient\\blowout\\blowout_siren" },
	{ name = "Earthquake", path = "ambient\\earthquake" },
	{ name = "Whispers",  path = "arszi_psy\\pripyat_whispers_final" },
	{ name = "Teleport",  path = "anomaly\\teleport_incoming" },
	{ name = "Tinnitus",  path = "affects\\tinnitus3a" },
	{ name = "Humming",   path = "ambient\\special\\light_humming" },
}

local function def_play_sound()
	return {
		id = "play_sound", name = "Something You Heard", category = "world",
		duration = 0, cooldown = 90, weight = 1.0,
		available = actor_online,
		execute = function(ctx, params)
			local pick = SOUNDS[math.random(#SOUNDS)]
			local snd = sound_object(pick.path)
			if not snd then return false, "no sound object for " .. pick.path end
			-- s2d plays in the player's head rather than at a world position:
			-- no level geometry involved, so it cannot misfire indoors.
			snd:play(db.actor, 0, sound_object.s2d)
			chaos_rt_log.debug("played sound %s", pick.path)
			return true
		end,
	}
end

--------------------------------------------------------------------------------
-- world
--------------------------------------------------------------------------------

local function hour()
	return level.get_time_hours()
end

--- Jump the clock forward to `target` hours. Never goes backwards: rewinding
--- game time upsets schedulers all over Anomaly.
local function skip_to_hour(target)
	local now = hour()
	local delta = (target - now) % 24
	if delta == 0 then delta = 24 end
	level.change_game_time(delta, 0, 0)
	return delta
end

local function def_nightfall()
	return {
		id = "nightfall", name = "Nightfall", category = "world",
		duration = 0, cooldown = 900, weight = 0.5,
		available = function()
			if not actor_online() then return false end
			local h = hour()
			return h >= 5 and h < 20
		end,
		execute = function(ctx, params)
			local skipped = skip_to_hour(23)
			chaos_rt_ui.notify(string.format("Night falls (+%dh)", skipped), 6)
			return true
		end,
	}
end

local function def_daybreak()
	return {
		id = "daybreak", name = "Daybreak", category = "world",
		duration = 0, cooldown = 900, weight = 0.5,
		available = function()
			if not actor_online() then return false end
			local h = hour()
			return h >= 20 or h < 5
		end,
		execute = function(ctx, params)
			local skipped = skip_to_hour(8)
			chaos_rt_ui.notify(string.format("The sun comes up (+%dh)", skipped), 6)
			return true
		end,
	}
end

local function def_emission()
	return {
		id = "emission", name = "Emission", category = "world",
		duration = 0, cooldown = 1800, weight = 0.1,
		available = function()
			if not actor_online() then return false end
			if not surge_manager then return false end
			return not surge_manager.is_started()
		end,
		execute = function(ctx, params)
			surge_manager.start_surge()
			chaos_rt_ui.notify("Emission incoming", 6)
			return true
		end,
	}
end

local function def_psi_storm()
	return {
		id = "psi_storm", name = "Psi Storm", category = "world",
		duration = 0, cooldown = 1200, weight = 0.2,
		available = function()
			if not actor_online() then return false end
			if not psi_storm_manager then return false end
			return not psi_storm_manager.is_started()
		end,
		execute = function(ctx, params)
			psi_storm_manager.get_psi_storm_manager():start(true)
			chaos_rt_ui.notify("Psi storm incoming", 6)
			return true
		end,
	}
end

--------------------------------------------------------------------------------
-- registration
--------------------------------------------------------------------------------

function register_all()
	for i = 1, #MUTANTS do
		chaos_rt_manager.register(def_spawn(MUTANTS[i], "mutants"))
	end
	for i = 1, #FACTIONS do
		chaos_rt_manager.register(def_spawn(FACTIONS[i], "factions"))
	end

	for i = 1, #STARTER_KITS do
		chaos_rt_manager.register(def_starter_kit(STARTER_KITS[i]))
	end
	for i = 1, #HANDOUTS do
		chaos_rt_manager.register(def_handout(HANDOUTS[i]))
	end
	chaos_rt_manager.register(def_spawn_ally())

	local defs = {
		def_give_random_weapon(),
		def_give_grenades(),
		def_give_bolt(),
		def_give_supplies(),
		def_give_artefact(),
		def_spawn_corpse(),
		def_heal_player(),
		def_damage_player(),
		def_irradiate(),
		def_drunk(),
		def_save_game(),
		def_play_sound(),
		def_nightfall(),
		def_daybreak(),
		def_emission(),
		def_psi_storm(),
	}
	for i = 1, #defs do
		chaos_rt_manager.register(defs[i])
	end

	chaos_rt_log.info("registered %d events", chaos_rt_manager.count())
end
