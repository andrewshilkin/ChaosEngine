local function def_spawn_corpse()
	local tier = TIERS.prop
	return {
		id = "spawn_corpse", name = "Fresh Corpse", category = "loot",
		duration = 0, cooldown = 150, weight = 0.8,
		params = {
			count = { type = "number", min = tier.min, max = tier.max, default = tier.default },
		},
		available = actor_online,
		execute = function(ctx, params)
			-- The *_dead profiles spawn already dead, carrying their gear.
			local n = spawn_around(CORPSES, params.count, tier.near, tier.far)
			if n == 0 then return false, "nowhere to put it" end
