		params = { count = { type = "number", min = 1, max = 5, default = 2 } },
		available = actor_online,
		execute = function(ctx, params)
			local given = 0
			for _ = 1, params.count do
				local section = (math.random() < 0.5) and "grenade_f1" or "grenade_rgd5"
				if alife_create_item(section, db.actor) then given = given + 1 end
			end
			if given == 0 then return false, "could not create any" end
			chaos_rt_ui.notify(string.format("Grenades x %d", given), 5)
			return true
		end,
